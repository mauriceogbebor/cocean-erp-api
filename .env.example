# Copy to .env and change every value outside local development.
DATABASE_URL=postgres://cocean:cocean@localhost:5432/cocean
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=4000
# The web app's origin, for CORS.
WEB_ORIGIN=http://localhost:3000
# First administrator, created by `pnpm db:seed` if no admin exists.
SEED_ADMIN_EMAIL=admin@cocean.local
SEED_ADMIN_PASSWORD=change-me-now-please
