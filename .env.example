# Copy to .env and change every value outside local development.
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=4000
# The web app's origin, for CORS.
WEB_ORIGIN=http://localhost:3000
# First administrator, created by `pnpm db:seed` if no admin exists.
# The organization's name on a new installation; changed later in Settings.
SEED_ORG_NAME=Your organization
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now-please
# Shared password for the sample people loaded by `pnpm db:seed:sample` (development only).
SAMPLE_PASSWORD=change-me-sample-password
# Shared secret the tracker provider sends in X-Tracker-Key with positions (32+ characters).
# TRACKER_API_KEY=
